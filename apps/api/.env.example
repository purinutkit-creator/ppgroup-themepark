NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/themepark
# Long random secrets — generate with: openssl rand -base64 48
JWT_SECRET=change-me-staff-and-member-jwt-secret
QR_SIGNING_SECRET=change-me-qr-hmac-secret
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
# Payment provider: simulator | (implement adapters in src/hardware/payment)
PAYMENT_PROVIDER=simulator
PROMPTPAY_ID=0812345678
# Hardware mode: simulator | real (per-device adapter config lives in DB)
HARDWARE_MODE=simulator
